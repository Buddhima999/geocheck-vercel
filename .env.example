# Copy this file to .env and fill in your own keys.
# Both keys come from the same Google Cloud project - see README.md for setup steps.

# Browser key: used by the frontend to load Google Maps. Restrict it (in Google
# Cloud Console) to the "Maps JavaScript API" and to your site's domain / localhost.
GOOGLE_MAPS_BROWSER_KEY=

# Server key: used by the backend to call the Geocoding API. Restrict it to the
# "Geocoding API" and to your server's IP address (not a domain - server-side
# calls don't send an HTTP referrer).
GOOGLE_GEOCODING_SERVER_KEY=

# MongoDB connection - a local mongod (the default) or a free MongoDB Atlas
# cluster both work. See README.md for setup instructions for either.
# MONGO_URI=mongodb://localhost:27017
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
# MONGO_DB_NAME=geocheck

# Optional overrides - defaults shown.
# MAX_UPLOAD_ROWS=5000
# MAX_UPLOAD_BYTES=3000000
# DEFAULT_OVERHEAD_THRESHOLD_M=500
# DEFAULT_LINE_THRESHOLD_M=500
# DEFAULT_ADDRESS_TOLERANCE_M=100
